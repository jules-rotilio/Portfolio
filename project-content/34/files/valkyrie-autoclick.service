# Start the auto-clicker with your desktop session. Install:
#   sed "s|@DIR@|$PWD|" valkyrie-autoclick.service > ~/.config/systemd/user/valkyrie-autoclick.service
#   systemctl --user daemon-reload && systemctl --user enable --now valkyrie-autoclick
# Reload the settings: systemctl --user reload valkyrie-autoclick
[Unit]
Description=Auto-clicker for the Drakkar Valkyrie mouse
After=graphical-session.target
PartOf=graphical-session.target

[Service]
ExecStart=@DIR@/bin/valkyrie-autoclick
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
